@model List<RecipeSite.Models.ApplicationUser>
@{
    ViewData["Title"] = "Поиск друзей";
    var query = ViewBag.Query as string;
    var statusByUserId = ViewBag.StatusByUserId as Dictionary<string, string> ?? new Dictionary<string, string>();
}

<div class="container mt-4 mb-5">
    <div class="card shadow border-0 rounded-4 p-4 p-md-5 bg-white">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <h3 class="fw-bold text-dark mb-0">Поиск друзей 🔍</h3>
            <a asp-controller="Friends" asp-action="Index" class="btn btn-outline-secondary rounded-3 fw-bold">Мои друзья</a>
        </div>

        <form asp-controller="Friends" asp-action="Search" method="get" class="mb-4">
            <div class="input-group">
                <input type="text" name="query" class="form-control rounded-start-3 py-2" placeholder="Введите ник пользователя..." value="@query" />
                <button type="submit" class="btn text-white fw-bold px-4 rounded-end-3" style="background-color:#ff6b8b;border:none;">Найти</button>
            </div>
        </form>

        @if (!string.IsNullOrWhiteSpace(query) && !Model.Any())
        {
            <p class="text-muted text-center py-4">Никого не найдено по запросу «@query» 🤷</p>
        }

        <div class="row g-3">
            @foreach (var user in Model)
            {
                var status = statusByUserId.TryGetValue(user.Id, out var s) ? s : "none";
                <div class="col-md-6">
                    <div class="d-flex align-items-center justify-content-between p-3 rounded-4 border bg-light">
                        <a asp-controller="Friends" asp-action="Profile" asp-route-userId="@user.Id" class="d-flex align-items-center text-decoration-none text-dark">
                            @if (!string.IsNullOrEmpty(user.AvatarUrl))
                            {
                                <img src="@user.AvatarUrl" alt="@user.UserName" style="width:44px;height:44px;border-radius:50%;object-fit:cover;margin-right:12px;" />
                            }
                            else
                            {
                                <span style="font-size:32px;margin-right:12px;">@(string.IsNullOrEmpty(user.AvatarPreset) ? "👤" : user.AvatarPreset)</span>
                            }
                            <div>
                                <div class="fw-bold">@user.UserName</div>
                                @if (!string.IsNullOrEmpty(user.FirstName))
                                {
                                    <div class="text-muted small">@user.FirstName @user.LastName</div>
                                }
                            </div>
                        </a>

                        @if (status == "friends")
                        {
                            <span class="badge rounded-pill bg-success-subtle text-success px-3 py-2">Друзья ✓</span>
                        }
                        else if (status == "pending_out")
                        {
                            <span class="badge rounded-pill bg-secondary-subtle text-secondary px-3 py-2">Заявка отправлена</span>
                        }
                        else if (status == "pending_in")
                        {
                            <a asp-controller="Friends" asp-action="Index" class="badge rounded-pill bg-warning-subtle text-dark px-3 py-2 text-decoration-none">Ответить на заявку</a>
                        }
                        else
                        {
                            <form asp-controller="Friends" asp-action="SendRequest" method="post">
                                <input type="hidden" name="userId" value="@user.Id" />
                                <input type="hidden" name="returnQuery" value="@query" />
                                <button type="submit" class="btn btn-sm text-white fw-bold rounded-3 px-3" style="background-color:#ff6b8b;border:none;">+ Добавить</button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>
