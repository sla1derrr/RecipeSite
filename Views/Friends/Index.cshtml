@model List<RecipeSite.Models.ApplicationUser?>
@{
    ViewData["Title"] = "Мои друзья";
    var incoming = ViewBag.IncomingRequests as List<RecipeSite.Models.Friendship> ?? new List<RecipeSite.Models.Friendship>();
    var outgoing = ViewBag.OutgoingRequests as List<RecipeSite.Models.Friendship> ?? new List<RecipeSite.Models.Friendship>();
}

<div class="container mt-4 mb-5">
    <div class="card shadow border-0 rounded-4 p-4 p-md-5 bg-white">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <h3 class="fw-bold text-dark mb-0">Мои друзья 👥</h3>
            <a asp-controller="Friends" asp-action="Search" class="btn text-white fw-bold rounded-3 px-4" style="background-color:#ff6b8b;border:none;">🔍 Найти друзей</a>
        </div>

        @if (incoming.Any())
        {
            <h6 class="fw-bold text-dark mb-3">Входящие заявки</h6>
            <div class="row g-3 mb-4">
                @foreach (var req in incoming)
                {
                    var user = req.Requester;
                    <div class="col-md-6">
                        <div class="d-flex align-items-center justify-content-between p-3 rounded-4 border bg-light">
                            <a asp-controller="Friends" asp-action="Profile" asp-route-userId="@user!.Id" class="d-flex align-items-center text-decoration-none text-dark">
                                @if (!string.IsNullOrEmpty(user.AvatarUrl))
                                {
                                    <img src="@user.AvatarUrl" style="width:40px;height:40px;border-radius:50%;object-fit:cover;margin-right:10px;" />
                                }
                                else
                                {
                                    <span style="font-size:28px;margin-right:10px;">@(string.IsNullOrEmpty(user.AvatarPreset) ? "👤" : user.AvatarPreset)</span>
                                }
                                <span class="fw-bold">@user.UserName</span>
                            </a>
                            <div class="d-flex gap-2">
                                <form asp-controller="Friends" asp-action="AcceptRequest" method="post">
                                    <input type="hidden" name="id" value="@req.Id" />
                                    <button type="submit" class="btn btn-sm btn-success rounded-3 fw-bold">Принять</button>
                                </form>
                                <form asp-controller="Friends" asp-action="DeclineRequest" method="post">
                                    <input type="hidden" name="id" value="@req.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-3">Отклонить</button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        @if (outgoing.Any())
        {
            <h6 class="fw-bold text-dark mb-3">Отправленные заявки</h6>
            <div class="row g-3 mb-4">
                @foreach (var req in outgoing)
                {
                    var user = req.Addressee;
                    <div class="col-md-6">
                        <div class="d-flex align-items-center justify-content-between p-3 rounded-4 border bg-light">
                            <span class="fw-bold">@user!.UserName</span>
                            <form asp-controller="Friends" asp-action="DeclineRequest" method="post">
                                <input type="hidden" name="id" value="@req.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary rounded-3">Отменить</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }

        <h6 class="fw-bold text-dark mb-3">Друзья</h6>
        @if (!Model.Any())
        {
            <p class="text-muted text-center py-4">Пока нет друзей. Найди их по нику 👆</p>
        }
        <div class="row g-3">
            @foreach (var user in Model)
            {
                if (user == null) { continue; }
                <div class="col-md-6">
                    <div class="d-flex align-items-center justify-content-between p-3 rounded-4 border bg-light">
                        <a asp-controller="Friends" asp-action="Profile" asp-route-userId="@user.Id" class="d-flex align-items-center text-decoration-none text-dark">
                            @if (!string.IsNullOrEmpty(user.AvatarUrl))
                            {
                                <img src="@user.AvatarUrl" style="width:44px;height:44px;border-radius:50%;object-fit:cover;margin-right:12px;" />
                            }
                            else
                            {
                                <span style="font-size:32px;margin-right:12px;">@(string.IsNullOrEmpty(user.AvatarPreset) ? "👤" : user.AvatarPreset)</span>
                            }
                            <span class="fw-bold">@user.UserName</span>
                        </a>
                        <form asp-controller="Friends" asp-action="RemoveFriend" method="post" onsubmit="return confirm('Удалить из друзей?');">
                            <input type="hidden" name="userId" value="@user.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-3">Удалить</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
