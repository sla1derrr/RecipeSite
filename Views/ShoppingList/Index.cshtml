@model List<RecipeSite.Models.ShoppingList>
@{
    ViewData["Title"] = "Список продуктов";
    var query = ViewBag.Query as string;
    var results = ViewBag.Results as List<RecipeSite.Services.MealDbMeal>;
}

<div class="container mt-4 mb-5">
    <div class="card shadow border-0 rounded-4 p-4 p-md-5 bg-white">

        <h3 class="fw-bold mb-1 text-dark">Список продуктов 🛒</h3>
        <p class="text-muted mb-4">Напишите блюдо, и мы составим список того, что нужно купить. Списков можно вести сколько угодно, по одному на каждое блюдо.</p>

        @if (TempData["Msg"] != null)
        {
            <div class="alert alert-warning rounded-3">@TempData["Msg"]</div>
        }

        <!-- Поиск блюда -->
        <form method="get" asp-action="Index" class="d-flex gap-2 mb-4">
            <input type="text" name="query" value="@query" class="form-control rounded-3 py-2"
                   placeholder="Что хотите приготовить? Например: курица, pasta, carbonara" required />
            <button type="submit" class="btn text-white fw-bold px-4 rounded-3" style="background-color:#ff6b8b;border:none;">Найти</button>
        </form>

        @if (!string.IsNullOrWhiteSpace(query))
        {
            <div class="p-3 p-md-4 rounded-4 bg-light border mb-4">
                <h6 class="fw-bold text-dark mb-3">Результаты по запросу «@query»</h6>

                @if (results != null && results.Any())
                {
                    <div class="row g-3">
                        @foreach (var meal in results)
                        {
                            <div class="col-6 col-md-4 col-xl-3">
                                <div class="card h-100 border shadow-sm rounded-4 overflow-hidden bg-white">
                                    @if (!string.IsNullOrEmpty(meal.ImageUrl))
                                    {
                                        <img src="@meal.ImageUrl" alt="@meal.Title" loading="lazy"
                                             style="height:110px;object-fit:cover;width:100%;" />
                                    }
                                    <div class="card-body p-3 d-flex flex-column justify-content-between">
                                        <div class="fw-bold small mb-2">@meal.Title</div>
                                        <form asp-action="CreateFromMeal" method="post">
                                            <input type="hidden" name="mealId" value="@meal.Id" />
                                            <button type="submit" class="btn btn-sm w-100 text-white fw-bold rounded-3"
                                                    style="background-color:#ff6b8b;border:none;">+ Составить список</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">Ничего не нашли. Каталог лучше понимает названия на английском (например, Carbonara, Lasagne), либо создайте список вручную.</p>
                }

                <form asp-action="CreateEmpty" method="post" class="mt-3">
                    <input type="hidden" name="dishName" value="@query" />
                    <button type="submit" class="btn btn-outline-secondary btn-sm rounded-3">Создать пустой список «@query» и заполнить самому</button>
                </form>
            </div>
        }

        <!-- Мои списки -->
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <div style="font-size:48px;">🛒</div>
                <p class="text-muted fs-5 mt-2 mb-0">Списков пока нет. Найдите блюдо выше 👆</p>
            </div>
        }

        <div class="row g-4">
            @foreach (var list in Model)
            {
                var total = list.Items.Count;
                var done = list.Items.Count(i => i.IsChecked);
                var percent = total == 0 ? 0 : done * 100 / total;

                <div class="col-md-6 col-xl-4">
                    <div class="card h-100 border shadow-sm rounded-4 overflow-hidden bg-white sl-card">
                        <div class="p-3" style="background:linear-gradient(135deg,#fff5f7 0%,#ffffff 100%);border-bottom:1px solid rgba(255,107,139,.15);">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <h5 class="fw-bold mb-0 text-dark">@list.DishName</h5>
                                <form asp-action="DeleteList" method="post" class="sl-delete-form" data-name="@list.DishName">
                                    <input type="hidden" name="id" value="@list.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-3" title="Удалить список">🗑️</button>
                                </form>
                            </div>
                            <div class="small text-muted mt-2"><span class="sl-count">@done из @total</span> куплено</div>
                            <div class="progress mt-1" style="height:6px;">
                                <div class="progress-bar sl-bar" style="width:@percent%;background-color:#ff6b8b;"></div>
                            </div>
                        </div>

                        <ul class="list-unstyled m-0 px-3 py-2">
                            @foreach (var item in list.Items)
                            {
                                <li class="sl-item d-flex align-items-center gap-2 py-2 border-bottom" data-id="@item.Id">
                                    <input type="checkbox" class="form-check-input sl-check m-0" checked="@item.IsChecked" />
                                    <span class="flex-grow-1 sl-name @(item.IsChecked ? "sl-done" : "")">@item.Name</span>
                                    @if (!string.IsNullOrEmpty(item.Amount))
                                    {
                                        <span class="text-muted small">@item.Amount</span>
                                    }
                                    <button type="button" class="btn btn-sm text-muted sl-del p-0 px-1" title="Убрать">✕</button>
                                </li>
                            }
                        </ul>

                        <div class="p-3 mt-auto">
                            <form asp-action="AddItem" method="post" class="d-flex gap-2">
                                <input type="hidden" name="listId" value="@list.Id" />
                                <input type="text" name="name" class="form-control form-control-sm rounded-3" placeholder="Добавить продукт" maxlength="100" required />
                                <input type="text" name="amount" class="form-control form-control-sm rounded-3" placeholder="Кол-во" maxlength="50" style="max-width:90px;" />
                                <button type="submit" class="btn btn-sm text-white fw-bold rounded-3" style="background-color:#ff6b8b;border:none;">+</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<div id="antiforgery">@Html.AntiForgeryToken()</div>

<!-- Окно подтверждения удаления списка -->
<div class="modal fade" id="slDeleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:400px;">
        <div class="modal-content border-0 rounded-4 shadow-lg">
            <div class="modal-body text-center p-4 p-md-5">
                <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle"
                     style="width:64px;height:64px;background:#fff0f3;font-size:30px;">🗑️</div>
                <h5 class="fw-bold text-dark mb-2">Удалить список?</h5>
                <p class="text-muted mb-4">Список «<span id="slDeleteName" class="fw-semibold"></span>» и все продукты в нём будут удалены. Это действие нельзя отменить.</p>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-light fw-bold rounded-3 flex-fill py-2" data-bs-dismiss="modal">Отмена</button>
                    <button type="button" id="slDeleteConfirm" class="btn text-white fw-bold rounded-3 flex-fill py-2"
                            style="background-color:#ff6b8b;border:none;">Удалить</button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .sl-done { text-decoration: line-through; color: #adb5bd; }
    .sl-check:checked { background-color: #ff6b8b; border-color: #ff6b8b; }
    .sl-del:hover { color: #dc3545 !important; }
</style>

@section Scripts {
    <script>
        (function () {
            var token = document.querySelector('#antiforgery input[name="__RequestVerificationToken"]').value;
            var toggleUrl = '@Url.Action("Toggle", "ShoppingList")';
            var deleteItemUrl = '@Url.Action("DeleteItem", "ShoppingList")';

            function post(url, data) {
                return fetch(url, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token,
                        'Content-Type': 'application/x-www-form-urlencoded'
                    },
                    body: new URLSearchParams(data)
                });
            }

            function updateProgress(card) {
                var total = card.querySelectorAll('.sl-item').length;
                var done = card.querySelectorAll('.sl-check:checked').length;
                card.querySelector('.sl-count').textContent = done + ' из ' + total;
                card.querySelector('.sl-bar').style.width = (total === 0 ? 0 : Math.round(done * 100 / total)) + '%';
            }

            // Красивое окно подтверждения вместо стандартного confirm()
            var modalEl = document.getElementById('slDeleteModal');
            var deleteModal = new bootstrap.Modal(modalEl);
            var pendingForm = null;

            document.querySelectorAll('.sl-delete-form').forEach(function (form) {
                form.addEventListener('submit', function (e) {
                    e.preventDefault();
                    pendingForm = form;
                    document.getElementById('slDeleteName').textContent = form.dataset.name || '';
                    deleteModal.show();
                });
            });

            document.getElementById('slDeleteConfirm').addEventListener('click', function () {
                if (pendingForm) pendingForm.submit(); // submit() не вызывает событие submit повторно
            });

            document.querySelectorAll('.sl-card').forEach(function (card) {
                card.addEventListener('change', function (e) {
                    if (!e.target.classList.contains('sl-check')) return;
                    var li = e.target.closest('.sl-item');
                    var checked = e.target.checked;
                    li.querySelector('.sl-name').classList.toggle('sl-done', checked);
                    updateProgress(card);

                    post(toggleUrl, { id: li.dataset.id, isChecked: checked }).then(function (r) {
                        if (!r.ok) {
                            e.target.checked = !checked;
                            li.querySelector('.sl-name').classList.toggle('sl-done', !checked);
                            updateProgress(card);
                        }
                    });
                });

                card.addEventListener('click', function (e) {
                    if (!e.target.classList.contains('sl-del')) return;
                    var li = e.target.closest('.sl-item');
                    post(deleteItemUrl, { id: li.dataset.id }).then(function (r) {
                        if (r.ok) { li.remove(); updateProgress(card); }
                    });
                });
            });
        })();
    </script>
}