@{
    ViewData["Title"] = "Главная";
}

<div class="container-fluid px-0">

    <!-- Главный приветственный баннер с фото на фоне -->
    <div class="home-hero mb-5 text-center">
        <div class="home-hero-overlay">
            <h1 class="display-5 fw-bold mb-3 text-white">Добро пожаловать в Foodify 🍳</h1>
            <p class="lead mx-auto mb-0 text-white-50" style="max-width: 800px;">
                Ваш личный кулинарный помощник. Мы создали платформу, чтобы избавить вас от хаоса в заметках и
                закладках.
                Храните, организуйте и готовьте с удовольствием.
            </p>
        </div>
    </div>

    <div class="container">
        <div class="row">

            <!-- Левая колонка: последний рецепт от друзей -->
            <div class="col-lg-3 mb-4">
                @{
                    var friendState = ViewBag.FriendState as string ?? "guest";
                    var friendRecipe = ViewBag.FriendRecipe as RecipeSite.Models.Recipe;
                    var friendUser = ViewBag.FriendUser as RecipeSite.Models.ApplicationUser;
                    var homeIcons = new Dictionary<string, string>
                    {
                        { "Завтраки", "🥞" }, { "Супы", "🍲" }, { "Вторые", "🍛" },
                        { "Сладкое", "🍰" }, { "Закуски", "🥟" }, { "Салаты", "🥗" }
                    };
                }
                <div class="card shadow-sm border-0 rounded-4 overflow-hidden sticky-top" style="top: 20px;">
                    <div class="card-body p-3">
                        <h6 class="fw-bold mb-3">👥 Новое у друзей</h6>

                        @if (friendState == "ok" && friendRecipe != null)
                        {
                            var icon = homeIcons.TryGetValue(friendRecipe.Category, out var emoji) ? emoji : "🍽️";
                            var author = friendUser?.UserName ?? "друг";

                            <a asp-controller="Friends" asp-action="Profile" asp-route-userId="@friendRecipe.UserId"
                               class="friend-recipe text-decoration-none text-dark d-block">
                                @if (friendRecipe.HasImage)
                                {
                                    <img src="/recipe-image/@friendRecipe.Id" alt="@friendRecipe.Title" loading="lazy"
                                         class="friend-recipe-img" />
                                }
                                else
                                {
                                    <div
                                        class="friend-recipe-img d-flex align-items-center justify-content-center bg-light fs-1">
                                        @icon</div>
                                    }
                                    <div class="pt-3">
                                        <span
                                        class="badge rounded-pill bg-light text-danger border px-2 py-1 mb-2 small">@friendRecipe.Category</span>
                                        <div class="fw-bold mb-1">@friendRecipe.Title</div>
                                        <div class="small text-muted">
                                            Добавил(а): <span class="fw-semibold" style="color:#ff6b8b;">@author</span>
                                        </div>
                                        <div class="small text-muted">@friendRecipe.CreatedAt.ToString("dd.MM.yyyy")</div>
                                    </div>
                                </a>
                                <a asp-controller="Friends" asp-action="Profile" asp-route-userId="@friendRecipe.UserId"
                                   class="d-block text-center small fw-bold mt-3" style="color:#ff6b8b;">
                                    Все рецепты @author →
                                </a>
                            }
                        else if (friendState == "norecipes")
                            {
                                <p class="text-muted small mb-3">Друзья пока не добавили ни одного рецепта.</p>
                                <a asp-controller="Friends" asp-action="Index" class="d-block text-center small fw-bold"
                                   style="color:#ff6b8b;">Мои друзья →</a>
                            }
                            else if (friendState == "nofriends")
                            {
                                <p class="text-muted small mb-3">Добавьте друзей, и здесь появятся их новые рецепты.</p>
                                <a asp-controller="Friends" asp-action="Search" class="feature-btn">Найти друзей →</a>
                            }
                            else
                            {
                                <p class="text-muted small mb-3">Войдите, чтобы видеть, что готовят ваши друзья.</p>
                                <a asp-area="Identity" asp-page="/Account/Login" class="feature-btn">Войти →</a>
                            }
                        </div>
                    </div>
                </div>

                <!-- Правая колонка: возможности сайта (список карточек друг под другом) -->
                <div class="col-lg-9">

                    <!-- Быстрые категории -->
                    @{
                        var quickCategories = ViewBag.QuickCategories as List<RecipeSite.Controllers.HomeCategory>
                                              ?? new List<RecipeSite.Controllers.HomeCategory>();
                    }
                    @if (quickCategories.Any())
                    {
                        <h5 class="fw-bold mb-3">Быстрые категории</h5>
                        <div class="category-chips mb-4">
                            @foreach (var cat in quickCategories)
                            {
                                <a href="@Url.Action("Index", "RecipeBook", new { category = cat.Key })" class="category-chip">
                                    <span class="category-chip-emoji">@cat.Emoji</span>@cat.Title
                                </a>
                            }
                            <a href="@Url.Action("Index", "RecipeBook")" class="category-chip category-chip--all">Все →</a>
                        </div>
                    }

                    <h5 class="fw-bold mb-3">Что можно делать на сайте</h5>

                    <div class="feature-list">

                        <div class="feature-card feature-card--pink">
                            <div class="feature-icon">🍱</div>
                            <div class="feature-body">
                                <h6 class="fw-bold mb-1">Удобные разделы блюд</h6>
                                <p class="text-muted small mb-0">Супы, вторые блюда, десерты и многое другое — всё разложено
                                    по полочкам для быстрого поиска.</p>
                                </div>
                                <a href="@Url.Action("Index", "RecipeBook")" class="feature-btn">Открыть книгу рецептов →</a>
                            </div>

                            <div class="feature-card feature-card--orange">
                                <div class="feature-icon">📱</div>
                                <div class="feature-body">
                                    <h6 class="fw-bold mb-1">Сохраняй из соцсетей</h6>
                                    <p class="text-muted small mb-0">Увидели крутой рецепт в TikTok или Instagram? Просто
                                        вставьте ссылку, и мы сохраним его к вам в книгу.</p>
                                    </div>
                                    <a href="@Url.Action("MyRecipes", "Recipes")" class="feature-btn">Перейти в мои рецепты →</a>
                                </div>

                                <div class="feature-card feature-card--purple">
                                    <div class="feature-icon">🎡</div>
                                    <div class="feature-body">
                                        <h6 class="fw-bold mb-1">Что приготовить?</h6>
                                        <p class="text-muted small mb-0">Не знаешь, что готовить сегодня? Крути колесо — оно выберет
                                            блюдо из твоих рецептов или каталога.</p>
                                        </div>
                                        <a href="@Url.Action("Index", "Wheel")" class="feature-btn">Крутить колесо →</a>
                                    </div>

                                    <div class="feature-card feature-card--yellow">
                                        <div class="feature-icon">✨</div>
                                        <div class="feature-body">
                                            <h6 class="fw-bold mb-1">Своя картинка</h6>
                                            <p class="text-muted small mb-0">Добавьте фото блюда в вашей книге рецептов с Tik-Tok или
                                                Reels, чтобы было легче определить что это за блюдо.</p>
                                            </div>
                                            <a asp-controller="Recipes" asp-action="MyRecipes" class="feature-btn">Добавить рецепт →</a>
                                        </div>

                                        <div class="feature-card feature-card--green">
                                            <div class="feature-icon">🛒</div>
                                            <div class="feature-body">
                                                <h6 class="fw-bold mb-1">Авто-список покупок</h6>
                                                <p class="text-muted small mb-0">Добавьте блюда в план на неделю, и Foodify сам соберет все
                                                    нужные ингредиенты в удобный список для магазина.</p>
                                                </div>
                                                <a asp-controller="ShoppingList" asp-action="Index" class="feature-btn">Составить список →</a>
                                            </div>

                                            <div class="feature-card feature-card--blue feature-card--soon">
                                                <div class="feature-icon">🥑</div>
                                                <div class="feature-body">
                                                    <h6 class="fw-bold mb-1">Холодильник <span class="soon-badge">Скоро</span></h6>
                                                    <p class="text-muted small mb-0">Впишите продукты, которые у вас сейчас есть, и мы
                                                        подскажем, какое блюдо из них можно приготовить прямо сейчас.</p>
                                                    </div>
                                                    <span class="feature-btn feature-btn--disabled">В разработке</span>
                                                </div>

                                            </div>
                                        </div>
                                    </div>


                                    <!-- ===== Блок "Как это работает" ===== -->
                                    <div class="how-it-works my-5 py-4">
                                        <h5 class="fw-bold text-center mb-4">Как это работает</h5>
                                        <div class="row g-4">
                                            <div class="col-md-4 text-center">
                                                <div class="how-step-badge mx-auto mb-3">1</div>
                                                <h6 class="fw-bold">Находите рецепт</h6>
                                                <p class="text-muted small px-lg-4">В книге рецептов, у себя в соцсетях или просто крутите колесо,
                                                    если не знаете, что готовить.</p>
                                                </div>
                                                <div class="col-md-4 text-center">
                                                    <div class="how-step-badge mx-auto mb-3">2</div>
                                                    <h6 class="fw-bold">Сохраняете к себе</h6>
                                                    <p class="text-muted small px-lg-4">Рецепт попадает в вашу личную книгу — больше никаких потерянных
                                                        заметок и закладок.</p>
                                                    </div>
                                                    <div class="col-md-4 text-center">
                                                        <div class="how-step-badge mx-auto mb-3">3</div>
                                                        <h6 class="fw-bold">Готовите с удовольствием</h6>
                                                        <p class="text-muted small px-lg-4">Открываете рецепт в любой момент — ингредиенты, шаги и всё
                                                            нужное всегда под рукой.</p>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- ===== Рецепт дня ===== -->
                                                @{
                                                    var daily = ViewBag.DailyMeal as RecipeSite.Services.MealDbMeal;
                                                }
                                                @if (daily != null)
                                                {
                                                    <div class="daily-recipe my-5">
                                                        @if (!string.IsNullOrEmpty(daily.ImageUrl))
                                                        {
                                                            <img src="@daily.ImageUrl" alt="@daily.Title" loading="lazy" class="daily-recipe-img" />
                                                        }
                                                        <div class="daily-recipe-body">
                                                            <div class="daily-recipe-label">🍽️ Рецепт дня</div>
                                                            <h4 class="fw-bold mb-2">@daily.Title</h4>
                                                            <p class="text-muted mb-3">Попробуйте приготовить это блюдо сегодня. Завтра здесь будет новое.</p>
                                                            <a asp-controller="RecipeBook" asp-action="Details" asp-route-id="@("meal_" + daily.Id)"
                                                               class="feature-btn">Смотреть рецепт →</a>
                                                        </div>
                                                    </div>
                                                }

                                            </div>
                                        </div>
