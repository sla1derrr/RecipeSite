@{
    ViewData["Title"] = "Главная";
}

<div class="container-fluid px-0">

    <!-- Главный приветственный баннер с фото на фоне -->
    <div class="home-hero mb-5 text-center">
        <div class="home-hero-overlay">
            <h1 class="display-5 fw-bold mb-3 text-white">Добро пожаловать в Foodify 🍳</h1>
            <p class="lead mx-auto mb-0 text-white-50" style="max-width: 800px;">
                Ваш личный кулинарный помощник. Мы создали платформу, чтобы избавить вас от хаоса в заметках и закладках.
                Храните, организуйте и готовьте с удовольствием.
            </p>
        </div>
    </div>

    <div class="container">
        <div class="row">

            <!-- Левая колонка: быстрые категории -->
            <div class="col-lg-3 mb-4">
                <div class="card shadow-sm border-0 rounded-3 sticky-top" style="top: 20px;">
                    <div class="card-body">
                        <h6 class="card-title fw-bold mb-3">🍽️ Быстрые категории</h6>
                        <div class="d-grid gap-2">
                            @{
                                var quickCategories = ViewBag.QuickCategories as List<string> ?? new List<string>();
                            }
                            @foreach (var cat in quickCategories)
                            {
                                <a href="@Url.Action("Index", "RecipeBook", new { category = cat })" class="quick-category-link">
                                    @cat
                                </a>
                            }
                        </div>
                        <a href="@Url.Action("Index", "RecipeBook")" class="d-block text-center small fw-bold mt-3" style="color:#ff6b8b;">
                            Смотреть все категории →
                        </a>
                    </div>
                </div>
            </div>

            <!-- Правая колонка: карусель возможностей сайта -->
            <div class="col-lg-9">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">Что можно делать на сайте</h5>
                    <div class="carousel-controls">
                        <button type="button" class="carousel-arrow" id="carouselPrev" aria-label="Назад">‹</button>
                        <button type="button" class="carousel-arrow" id="carouselNext" aria-label="Вперёд">›</button>
                    </div>
                </div>

                <div class="feature-carousel-wrap">
                    <div class="feature-carousel-track" id="carouselTrack">

                        <div class="feature-slide">
                            <div class="feature-card feature-card--pink">
                                <div class="fs-1 mb-3">🍱</div>
                                <h5 class="fw-bold">Удобные разделы блюд</h5>
                                <p class="text-muted small">Супы, вторые блюда, десерты и многое другое — всё разложено по полочкам для быстрого поиска.</p>
                                <a href="@Url.Action("Index", "RecipeBook")" class="feature-btn">Открыть книгу рецептов →</a>
                            </div>
                        </div>

                        <div class="feature-slide">
                            <div class="feature-card feature-card--orange">
                                <div class="fs-1 mb-3">📱</div>
                                <h5 class="fw-bold">Сохраняй из соцсетей</h5>
                                <p class="text-muted small">Увидели крутой рецепт в TikTok или Instagram? Просто вставьте ссылку, и мы сохраним его к вам в книгу.</p>
                                <a href="@Url.Action("MyRecipes", "Recipes")" class="feature-btn">Перейти в мои рецепты →</a>
                            </div>
                        </div>

                        <div class="feature-slide">
                            <div class="feature-card feature-card--purple">
                                <div class="fs-1 mb-3">🎡</div>
                                <h5 class="fw-bold">Что приготовить?</h5>
                                <p class="text-muted small">Не знаешь, что готовить сегодня? Крути колесо — оно выберет блюдо из твоих рецептов или каталога.</p>
                                <a href="@Url.Action("Index", "Wheel")" class="feature-btn">Крутить колесо →</a>
                            </div>
                        </div>

                        <div class="feature-slide">
                            <div class="feature-card feature-card--yellow feature-card--soon">
                                <span class="soon-badge">Скоро</span>
                                <div class="fs-1 mb-3">✨</div>
                                <h5 class="fw-bold">Умные картинки</h5>
                                <p class="text-muted small">Нет подходящего фото для рецепта? Придумайте название блюду, а картинка сгенерируется автоматически.</p>
                                <span class="feature-btn feature-btn--disabled">В разработке</span>
                            </div>
                        </div>

                        <div class="feature-slide">
                            <div class="feature-card feature-card--green feature-card--soon">
                                <span class="soon-badge">Скоро</span>
                                <div class="fs-1 mb-3">🛒</div>
                                <h5 class="fw-bold">Авто-список покупок</h5>
                                <p class="text-muted small">Добавьте блюда в план на неделю, и Foodify сам соберет все нужные ингредиенты в удобный список для магазина.</p>
                                <span class="feature-btn feature-btn--disabled">В разработке</span>
                            </div>
                        </div>

                        <div class="feature-slide">
                            <div class="feature-card feature-card--blue feature-card--soon">
                                <span class="soon-badge">Скоро</span>
                                <div class="fs-1 mb-3">🥑</div>
                                <h5 class="fw-bold">Холодильник</h5>
                                <p class="text-muted small">Впишите продукты, которые у вас сейчас есть, и мы подскажем, какое блюдо из них можно приготовить прямо сейчас.</p>
                                <span class="feature-btn feature-btn--disabled">В разработке</span>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="d-flex justify-content-center gap-2 mt-3" id="carouselDots"></div>

            </div>
        </div>

        <!-- ===== Блок "Как это работает" ===== -->
        <div class="how-it-works my-5 py-4">
            <h5 class="fw-bold text-center mb-4">Как это работает</h5>
            <div class="row g-4">
                <div class="col-md-4 text-center">
                    <div class="how-step-badge mx-auto mb-3">1</div>
                    <h6 class="fw-bold">Находите рецепт</h6>
                    <p class="text-muted small px-lg-4">В книге рецептов, у себя в соцсетях или просто крутите колесо, если не знаете, что готовить.</p>
                </div>
                <div class="col-md-4 text-center">
                    <div class="how-step-badge mx-auto mb-3">2</div>
                    <h6 class="fw-bold">Сохраняете к себе</h6>
                    <p class="text-muted small px-lg-4">Рецепт попадает в вашу личную книгу — больше никаких потерянных заметок и закладок.</p>
                </div>
                <div class="col-md-4 text-center">
                    <div class="how-step-badge mx-auto mb-3">3</div>
                    <h6 class="fw-bold">Готовите с удовольствием</h6>
                    <p class="text-muted small px-lg-4">Открываете рецепт в любой момент — ингредиенты, шаги и всё нужное всегда под рукой.</p>
                </div>
            </div>
        </div>

        <!-- ===== CTA-баннер снизу ===== -->
        <div class="home-cta text-center rounded-4 my-5 p-5">
            <h4 class="fw-bold text-white mb-2">Готовы навести порядок в своих рецептах?</h4>
            <p class="text-white-50 mb-4">Начните с книги рецептов или сохраните первый рецепт из соцсетей прямо сейчас.</p>
            <div class="d-flex justify-content-center gap-3 flex-wrap">
                <a href="@Url.Action("Index", "RecipeBook")" class="btn btn-light fw-bold px-4 py-2 rounded-3 shadow-sm">📖 Книга рецептов</a>
                <a href="@Url.Action("MyRecipes", "Recipes")" class="btn btn-outline-light fw-bold px-4 py-2 rounded-3">📱 Мои рецепты</a>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        (function () {
            // ================= КАРУСЕЛЬ ВОЗМОЖНОСТЕЙ =================
            const track = document.getElementById('carouselTrack');
            if (!track) return;

            const slides = Array.from(track.children);
            const dotsWrap = document.getElementById('carouselDots');
            const prevBtn = document.getElementById('carouselPrev');
            const nextBtn = document.getElementById('carouselNext');

            let slideWidth = 0;
            let index = 0;
            let autoplayTimer = null;
            let isPointerDown = false;
            let dragStartX = 0;
            let dragStartScroll = 0;
            let didDrag = false;

            function slidesPerView() {
                if (window.innerWidth < 576) return 1;
                if (window.innerWidth < 992) return 2;
                return 3;
            }

            function maxIndex() {
                return Math.max(0, slides.length - slidesPerView());
            }

            function measure() {
                if (!slides.length) return;
                slideWidth = slides[0].getBoundingClientRect().width + 16; // + gap
            }

            function goTo(i, smooth = true) {
                index = Math.min(Math.max(i, 0), maxIndex());
                track.style.scrollBehavior = smooth ? 'smooth' : 'auto';
                track.scrollLeft = index * slideWidth;
                updateDots();
            }

            function buildDots() {
                dotsWrap.innerHTML = '';
                const total = maxIndex() + 1;
                for (let i = 0; i < total; i++) {
                    const dot = document.createElement('span');
                    dot.className = 'carousel-dot' + (i === 0 ? ' active' : '');
                    dot.addEventListener('click', function () {
                        stopAutoplay();
                        goTo(i);
                        startAutoplay();
                    });
                    dotsWrap.appendChild(dot);
                }
            }

            function updateDots() {
                Array.from(dotsWrap.children).forEach(function (d, i) {
                    d.classList.toggle('active', i === index);
                });
            }

            function next() {
                goTo(index + 1 > maxIndex() ? 0 : index + 1);
            }

            function prev() {
                goTo(index - 1 < 0 ? maxIndex() : index - 1);
            }

            function startAutoplay() {
                stopAutoplay();
                autoplayTimer = setInterval(next, 3500);
            }

            function stopAutoplay() {
                if (autoplayTimer) clearInterval(autoplayTimer);
            }

            // ---------- Перетаскивание мышкой / свайп пальцем ----------
            track.addEventListener('pointerdown', function (e) {
                isPointerDown = true;
                didDrag = false;
                dragStartX = e.clientX;
                dragStartScroll = track.scrollLeft;
                track.style.scrollBehavior = 'auto';
                stopAutoplay();
            });

            window.addEventListener('pointermove', function (e) {
                if (!isPointerDown) return;
                const delta = e.clientX - dragStartX;
                if (Math.abs(delta) > 5) didDrag = true;
                track.scrollLeft = dragStartScroll - delta;
            });

            window.addEventListener('pointerup', function () {
                if (!isPointerDown) return;
                isPointerDown = false;
                const nearest = Math.round(track.scrollLeft / slideWidth);
                goTo(nearest);
                startAutoplay();
            });

            // Не даём клику по ссылке сработать сразу после перетаскивания
            track.addEventListener('click', function (e) {
                if (didDrag) {
                    e.preventDefault();
                    e.stopPropagation();
                }
            }, true);

            if (prevBtn) prevBtn.addEventListener('click', function () { stopAutoplay(); prev(); startAutoplay(); });
            if (nextBtn) nextBtn.addEventListener('click', function () { stopAutoplay(); next(); startAutoplay(); });

            track.addEventListener('mouseenter', stopAutoplay);
            track.addEventListener('mouseleave', startAutoplay);

            window.addEventListener('resize', function () {
                measure();
                buildDots();
                goTo(Math.min(index, maxIndex()), false);
            });

            measure();
            buildDots();
            startAutoplay();
        })();
    </script>
}
