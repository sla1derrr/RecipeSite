@model List<RecipeSite.Models.Recipe>
@{
    ViewData["Title"] = "Мои рецепты";
    var categories = ViewBag.Categories as string[] ?? Array.Empty<string>();
}

<div class="container mt-4 mb-5">
    <!-- Главная карточка-обертка в стиле Foodify -->
    <div class="card shadow border-0 rounded-4 p-4 p-md-5 bg-white">
        
        <!-- Заголовок страницы -->
        <h3 class="fw-bold mb-4 text-dark">Мои рецепты 📖</h3>

        <div class="row g-4">
            <!-- Левая колонка: категории и поиск -->
            <div class="col-lg-3">
                <!-- Блок поиска -->
                <div class="p-3 rounded-4 bg-light border mb-3">
                    <label class="form-label text-muted small fw-bold">Поиск</label>
                    <input type="text" id="searchInput" class="form-control rounded-3 py-2" placeholder="Найти по названию..."
                           oninput="filterRecipes()" />
                </div>

                <!-- Блок категорий -->
                <div class="p-3 rounded-4 bg-light border">
                    <label class="form-label text-muted small fw-bold mb-2">Категории</label>
                    <div class="list-group list-group-flush rounded-3 overflow-hidden">
                        <button type="button" class="list-group-item list-group-item-action category-filter active border-0 py-2"
                                data-category="all" onclick="selectCategory(this)">
                            Все рецепты
                        </button>
                        @foreach (var cat in categories)
                        {
                            <button type="button" class="list-group-item list-group-item-action category-filter border-0 py-2 text-dark bg-transparent"
                                    data-category="@cat" onclick="selectCategory(this)">
                                @cat
                            </button>
                        }
                    </div>
                </div>
            </div>

            <!-- Правая колонка: форма добавления + список рецептов -->
            <div class="col-lg-9">
                
                <!-- Форма добавления рецепта -->
                <div class="p-4 rounded-4 bg-light border mb-4">
                    <h5 class="fw-bold text-dark mb-3">Добавить рецепт ✨</h5>
                    <form asp-controller="Recipes" asp-action="AddRecipe" method="post">
                        <div class="row g-3">
                            <div class="col-md-5">
                                <label class="form-label small fw-bold text-muted">Название блюда</label>
                                <input type="text" name="title" class="form-control rounded-3 py-2" placeholder="Например: Тирамису"
                                       required />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label small fw-bold text-muted">Категория</label>
                                <select name="category" class="form-select rounded-3 py-2" required>
                                    @foreach (var cat in categories)
                                    {
                                        <option value="@cat">@cat</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-bold text-muted">Ссылка на TikTok/Reels</label>
                                <input type="url" name="sourceUrl" class="form-control rounded-3 py-2" placeholder="https://..." />
                            </div>
                        </div>

                        <button type="submit" class="btn text-white fw-bold px-4 py-2 mt-3 rounded-3 shadow-sm" style="background-color: #ff6b8b; border: none;">
                            Добавить рецепт
                        </button>
                    </form>
                </div>

                <!-- Сетка рецептов -->
                <div id="recipesGrid" class="row g-4">
                    @if (!Model.Any())
                    {
                        <div class="col-12 text-center py-5">
                            <p class="text-muted fs-5" id="emptyMessage">Пока нет ни одного рецепта. Добавь первый выше 👆</p>
                        </div>
                    }
                    @foreach (var recipe in Model)
                    {
                        <div class="col-md-4 recipe-card-wrapper" data-category="@recipe.Category"
                             data-title="@recipe.Title.ToLower()">
                            <div class="card h-100 border shadow-sm rounded-4 overflow-hidden recipe-card bg-white" style="transition: transform 0.2s;">
                                <div class="recipe-placeholder d-flex align-items-center justify-content-center bg-light text-muted fs-1" style="height: 140px;">
                                    @{
                                        var categoryIcons = new Dictionary<string, string>
                                        {
                                            { "Супы", "🍲" },
                                            { "Вторые", "🍛" },
                                            { "Сладкое", "🍰" },
                                            { "Закуски", "🥟" },
                                            { "Салаты", "🥗" }
                                        };
                                        var icon = categoryIcons.TryGetValue(recipe.Category, out var emoji) ? emoji : "🍽️";
                                    }
                                    @icon
                                </div>
                                <div class="card-body d-flex flex-column justify-content-between p-3">
                                    <div>
                                        <span class="badge rounded-pill bg-light text-danger border px-2 py-1 mb-2 small">@recipe.Category</span>
                                        <h6 class="card-title fw-bold text-dark mb-2">@recipe.Title</h6>
                                        @if (!string.IsNullOrEmpty(recipe.SourceUrl))
                                        {
                                            <a href="@recipe.SourceUrl" target="_blank" class="d-block mb-3 text-decoration-none small" style="color: #ff6b8b;">🔗 Открыть источник</a>
                                        }
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-danger rounded-3 w-100"
                                            onclick="openDeleteModal(@recipe.Id, '@recipe.Title')">Удалить</button>
                                </div>
                            </div>
                        </div>
                    }
                    <div class="col-12 text-center py-4">
                        <p class="text-muted d-none fs-5" id="noResultsMessage">Ничего не найдено 🔍</p>
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>

<!-- Модальное окно подтверждения удаления -->
<div id="deleteModalOverlay" class="delete-modal-overlay d-none" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 1050;">
    <div class="delete-modal-box card border-0 rounded-4 p-4 bg-white shadow-lg text-center" style="max-width: 400px; width: 90%;">
        <div style="font-size:40px;" class="mb-2">🗑️</div>
        <h5 class="fw-bold mb-2">Удалить рецепт?</h5>
        <p class="text-muted mb-4 small">«<span id="deleteModalTitle"></span>» будет удалён без возможности восстановления.</p>
        <form id="deleteModalForm" asp-controller="Recipes" asp-action="DeleteRecipe" method="post"
              class="d-flex gap-2 justify-content-center">
            <input type="hidden" name="id" id="deleteModalId" value="" />
            <button type="button" class="btn btn-secondary rounded-3 px-4" onclick="closeDeleteModal()">Отмена</button>
            <button type="submit" class="btn btn-danger rounded-3 px-4">Удалить</button>
        </form>
    </div>
</div>

<script>
    let currentCategory = 'all';

    function selectCategory(button) {
        document.querySelectorAll('.category-filter').forEach(function (btn) {
            btn.classList.remove('active', 'text-white');
            btn.classList.add('text-dark', 'bg-transparent');
            btn.style.backgroundColor = '';
            btn.style.borderColor = '';
        });
        button.classList.add('active', 'text-white');
        button.classList.remove('text-dark', 'bg-transparent');
        button.style.backgroundColor = '#ff6b8b';
        button.style.borderColor = '#ff6b8b';
        
        currentCategory = button.getAttribute('data-category');
        filterRecipes();
    }

    function filterRecipes() {
        var search = document.getElementById('searchInput').value.toLowerCase();
        var cards = document.querySelectorAll('.recipe-card-wrapper');
        var visibleCount = 0;

        cards.forEach(function (card) {
            var matchesCategory = currentCategory === 'all' || card.getAttribute('data-category') === currentCategory;
            var matchesSearch = card.getAttribute('data-title').includes(search);

            if (matchesCategory && matchesSearch) {
                card.classList.remove('d-none');
                visibleCount++;
            } else {
                card.classList.add('d-none');
            }
        });

        var noResults = document.getElementById('noResultsMessage');
        if (visibleCount === 0 && cards.length > 0) {
            noResults.classList.remove('d-none');
        } else {
            noResults.classList.add('d-none');
        }
    }

    function openDeleteModal(id, title) {
        document.getElementById('deleteModalId').value = id;
        document.getElementById('deleteModalTitle').textContent = title;
        document.getElementById('deleteModalOverlay').classList.remove('d-none');
    }

    function closeDeleteModal() {
        document.getElementById('deleteModalOverlay').classList.add('d-none');
    }
</script>

<style>
    /* Плавное увеличение карточки при наведении */
    .recipe-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.1) !important;
    }
    /* Кастомизация активной категории в списке */
    .list-group-item.active {
        background-color: #ff6b8b !important;
        border-color: #ff6b8b !important;
    }
</style>