@model RecipeSite.Services.SpoonacularRecipe
@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-4 mb-5">
    <!-- Кнопка назад -->
    <a asp-controller="RecipeBook" asp-action="Index" class="btn btn-outline-secondary mb-3 rounded-3 px-3 py-2 border-0 bg-white shadow-sm text-dark fw-bold">
        ← Назад к каталогу
    </a>

    <!-- Главная карточка-обертка в стиле Foodify -->
    <div class="card shadow border-0 rounded-4 p-4 p-md-5 bg-white">
        <div class="row g-4 align-items-center">
            
            <!-- Левая колонка: картинка -->
            <div class="col-lg-5">
                @if (!string.IsNullOrEmpty(Model.Image))
                {
                    <img src="@Model.Image" alt="@Model.Title" class="img-fluid rounded-4 shadow-sm w-100" style="object-fit: cover; max-height: 350px;" />
                }
                else
                {
                    <div class="d-flex align-items-center justify-content-center bg-light rounded-4 text-muted fs-1 shadow-sm" style="height: 250px;">🍽️</div>
                }
            </div>

            <!-- Правая колонка: название, теги и ингредиенты -->
            <div class="col-lg-7">
                <h2 class="fw-bold mb-3 text-dark">@Model.Title</h2>
                
                <div class="d-flex flex-wrap gap-2 mb-4">
                    @if (Model.ReadyInMinutes.HasValue)
                    {
                        <span class="badge rounded-pill bg-light text-secondary border px-3 py-2">⏱ @Model.ReadyInMinutes мин</span>
                    }
                    @if (Model.Servings.HasValue)
                    {
                        <span class="badge rounded-pill bg-light text-dark border px-3 py-2">🍽 @Model.Servings порций</span>
                    }
                </div>

                <h5 class="fw-bold text-dark mb-3">Ингредиенты</h5>
                <ul class="list-group list-group-flush mb-4 border rounded-3 overflow-hidden" style="max-height: 250px; overflow-y: auto;">
                    @if (Model.ExtendedIngredients != null)
                    {
                        @foreach (var ing in Model.ExtendedIngredients)
                        {
                            <li class="list-group-item bg-transparent px-3 py-2 text-secondary border-bottom">@ing.Original</li>
                        }
                    }
                </ul>

                @if (!string.IsNullOrEmpty(Model.SourceUrl))
                {
                    <a href="@Model.SourceUrl" target="_blank" class="btn btn-lg rounded-3 text-white shadow-sm fw-bold w-100 py-3" style="background-color: #ff6b8b; border: none;">
                        🔗 Оригинальный рецепт
                    </a>
                }
            </div>
        </div>

        <hr class="my-4 text-muted opacity-25" />

        <h5 class="fw-bold text-dark mb-3">Способ приготовления</h5>
        <div class="p-3 rounded-3 bg-light border-0">
            @if (!string.IsNullOrEmpty(Model.Instructions))
            {
                <div class="text-secondary mb-0" style="white-space: pre-line; line-height: 1.6;">@Html.Raw(Model.Instructions)</div>
            }
            else
            {
                <p class="text-muted mb-0">Инструкция недоступна — смотри оригинальный рецепт по ссылке выше.</p>
            }
        </div>
    </div>
</div>

<style>
    /* Плавный эффект при наведении на брендированную кнопку */
    a[target="_blank"]:hover {
        background-color: #ff5277 !important;
        transform: translateY(-2px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
    }
</style>