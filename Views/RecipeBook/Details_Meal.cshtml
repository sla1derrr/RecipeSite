@model RecipeSite.Services.MealDbMeal
@{
    ViewData["Title"] = Model.Title;
    var ingredients = Model.GetIngredients();
}

<div class="my-recipes-page">
    <a asp-controller="RecipeBook" asp-action="Index" class="btn btn-outline-secondary mb-4">← Назад к каталогу</a>

    <div class="card shadow-sm soft-card p-4">
        <div class="row">
            <div class="col-md-5 mb-3">
                <img src="@Model.ImageUrl" alt="@Model.Title" class="img-fluid rounded-4 shadow-sm" />
            </div>
            <div class="col-md-7">
                <h2 class="mb-2">@Model.Title</h2>
                <div class="mb-3">
                    @if (!string.IsNullOrEmpty(Model.Category))
                    {
                        <span class="badge bg-secondary me-2">@Model.Category</span>
                    }
                    @if (!string.IsNullOrEmpty(Model.Area))
                    {
                        <span class="badge bg-info text-dark">@Model.Area</span>
                    }
                </div>

                <h5 class="mt-4 mb-2">Ингредиенты</h5>
                <ul class="list-group list-group-flush mb-3">
                    @foreach (var (ingredient, measure) in ingredients)
                    {
                        <li class="list-group-item bg-transparent px-0">
                            <strong>@ingredient</strong> — @measure
                        </li>
                    }
                </ul>

                @if (!string.IsNullOrEmpty(Model.YoutubeUrl))
                {
                    <a href="@Model.YoutubeUrl" target="_blank" class="btn btn-danger mb-3">▶ Видео-рецепт на YouTube</a>
                }
            </div>
        </div>

        <hr class="my-4" />

        <h5 class="mb-3">Способ приготовления</h5>
        <p style="white-space: pre-line;">@Model.Instructions</p>
    </div>
</div>