@model List<RecipeSite.Services.CatalogRecipe>
@{
    ViewData["Title"] = "Книга рецептов";
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
    var selectedCategory = ViewBag.SelectedCategory as string;
    var searchQuery = ViewBag.SearchQuery as string;
}

<div class="container mt-4 mb-5">
    <!-- Единая большая карточка-обертка в стиле Foodify -->
    <div class="card shadow border-0 rounded-4 p-4 p-md-5 bg-white">
        
        <!-- Заголовок внутри карточки -->
        <h3 class="fw-bold mb-4 text-dark">Книга рецептов 🌍</h3>

        <div class="row g-4">
            <!-- Левая колонка: поиск и категории -->
            <div class="col-lg-3">
                <!-- Блок поиска -->
                <div class="p-3 rounded-4 bg-light border mb-3">
                    <form asp-controller="RecipeBook" asp-action="Index" method="get">
                        <label class="form-label text-muted small fw-bold">Поиск</label>
                        <input type="text" name="search" class="form-control rounded-3 py-2" placeholder="Найти блюдо..." value="@searchQuery" />
                    </form>
                </div>

                <!-- Блок категорий -->
                <div class="p-3 rounded-4 bg-light border">
                    <label class="form-label text-muted small fw-bold mb-2">Категории</label>
                    <div class="list-group list-group-flush rounded-3 overflow-hidden" style="max-height: 420px; overflow-y: auto;">
                        @{
                            var homeStyleActive = (selectedCategory == "Простые домашние" && string.IsNullOrEmpty(searchQuery)) ? "active text-white" : "text-dark bg-transparent";
                            var activeStyle = homeStyleActive.Contains("active") ? "background-color: #ff6b8b; border-color: #ff6b8b;" : "";
                        }
                        <a class="list-group-item list-group-item-action category-filter border-0 py-2 @homeStyleActive"
                           style="@activeStyle"
                           asp-controller="RecipeBook" asp-action="Index" asp-route-category="Простые домашние">
                            🏠 Простые домашние
                        </a>
                        
                        @foreach (var cat in categories)
                        {
                            var isCatActive = (cat == selectedCategory && string.IsNullOrEmpty(searchQuery));
                            var catClass = isCatActive ? "active text-white" : "text-dark bg-transparent";
                            var catStyle = isCatActive ? "background-color: #ff6b8b; border-color: #ff6b8b;" : "";

                            <a class="list-group-item list-group-item-action category-filter border-0 py-2 @catClass"
                               style="@catStyle"
                               asp-controller="RecipeBook" asp-action="Index" asp-route-category="@cat">
                                @cat
                            </a>
                        }
                    </div>
                </div>
            </div>

            <!-- Правая колонка: список блюд -->
            <div class="col-lg-9">
                @if (!string.IsNullOrEmpty(searchQuery))
                {
                    <p class="text-muted mb-3 small">Результаты поиска по запросу «@searchQuery»</p>
                }

                <div class="row g-4">
                    @if (Model == null || !Model.Any())
                    {
                        <div class="col-12 text-center py-5">
                            <p class="text-muted fs-5">Ничего не найдено 🔍</p>
                        </div>
                    }
                    @foreach (var recipe in Model!)
                    {
                        <div class="col-md-4">
                            <a asp-controller="RecipeBook" asp-action="Details" asp-route-id="@recipe.Id" class="text-decoration-none text-dark h-100 d-block">
                                <!-- Карточка отдельного рецепта со скруглениями и тенью -->
                                <div class="card h-100 border shadow-sm rounded-4 overflow-hidden recipe-card bg-white" style="transition: transform 0.2s;">
                                    @if (!string.IsNullOrEmpty(recipe.ImageUrl))
                                    {
                                        <img src="@recipe.ImageUrl" class="card-img-top" alt="@recipe.Title" style="height:160px; object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <div class="recipe-placeholder d-flex align-items-center justify-content-center bg-light text-muted fs-1" style="height:160px;">🍽️</div>
                                    }
                                    <div class="card-body d-flex flex-column justify-content-between p-3">
                                        @if (!string.IsNullOrEmpty(recipe.Category))
                                        {
                                            <div>
                                                <span class="badge rounded-pill bg-light text-danger border px-2 py-1 mb-2 small">@recipe.Category</span>
                                            </div>
                                        }
                                        <h6 class="card-title fw-bold text-dark mb-0">@recipe.Title</h6>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>
</div>

<style>
    /* Плавное увеличение карточки рецепта при наведении мышки */
    .recipe-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.1) !important;
    }
    /* Переопределение цвета активного элемента в списке категорий под стиль сайта */
    .list-group-item.active {
        background-color: #ff6b8b !important;
        border-color: #ff6b8b !important;
    }
</style>