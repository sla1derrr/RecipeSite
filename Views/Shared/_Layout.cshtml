<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] Foodify</title>
    <script type="importmap"></script> 
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RecipeSite.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico?v=2" />
    <link rel="apple-touch-icon" href="~/logo.png" />
</head>

<body>
    <!-- Скрытый оригинальный виджет Google Translate -->
    <div id="google_translate_element" style="display:none;"></div>

    <!-- Наш красивый кастомный переключатель (Dropup - открывается вверх) -->
    <div class="dropdown dropup" style="position:fixed; bottom:20px; right:20px; z-index:1000;">
        <button class="btn btn-primary rounded-pill dropdown-toggle px-3 shadow"
                style="background-color: #ff6b8b; border: none;" type="button" data-bs-toggle="dropdown"
                aria-expanded="false">
            🌍 Язык
        </button>
        <ul class="dropdown-menu border-0 shadow-sm mb-2">
            <li><a class="dropdown-item custom-lang-btn" href="#" data-lang="ru">Русский</a></li>
            <li><a class="dropdown-item custom-lang-btn" href="#" data-lang="en">English</a></li>
            <li><a class="dropdown-item custom-lang-btn" href="#" data-lang="pl">Polski</a></li>
            <li><a class="dropdown-item custom-lang-btn" href="#" data-lang="uk">Українська</a></li>
        </ul>
    </div>

    <script type="text/javascript">
        function googleTranslateElementInit() {
        new google.translate.TranslateElement({
        pageLanguage: 'ru',
        includedLanguages: 'ru,en,pl,uk',
        autoDisplay: false
        }, 'google_translate_element');
        }

        // Скрипт, который передает выбор из нашего красивого меню в скрытый гугл-переводчик
        document.addEventListener("click", function (e) {
        if (e.target.classList.contains("custom-lang-btn")) {
        e.preventDefault();
        let lang = e.target.getAttribute("data-lang");
        let gtSelect = document.querySelector(".goog-te-combo");
        if (gtSelect) {
        gtSelect.value = lang;
        gtSelect.dispatchEvent(new Event("change"));
        }
        }
        });
    </script>
    <script type="text/javascript"
            src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>

    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">🍳 Foodify</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home"
                               asp-action="Index">Главная</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="RecipeBook" asp-action="Index">Книга
                                рецептов</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Recipes" asp-action="MyRecipes">Мои
                                    рецепты</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Wheel" asp-action="Index">Что приготовить?</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Home"
                                       asp-action="Privacy">Конфиденциальность</a>
                                </li>
                            </ul>
                            <partial name="_LoginPartial" />
                        </div>
                    </div>
                </nav>
            </header>
            <div class="container">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>
            <script src="~/lib/jquery/dist/jquery.min.js"></script>
            <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
            <script src="~/js/site.js" asp-append-version="true"></script>
            @await RenderSectionAsync("Scripts", required: false)
        </body>

    </html>