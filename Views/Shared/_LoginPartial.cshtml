@using Microsoft.AspNetCore.Identity
@using RecipeSite.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);

    var avatarUrl = currentUser?.AvatarUrl;
    var avatarPreset = currentUser?.AvatarPreset;
    var nickname = !string.IsNullOrEmpty(currentUser?.FirstName) ? currentUser.FirstName : (currentUser?.UserName ?? "Профиль");

    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle d-flex align-items-center text-dark" href="#" id="userMenuLink" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            @if (!string.IsNullOrEmpty(avatarUrl))
            {
                <img src="@avatarUrl" alt="Аватар" style="width:32px;height:32px;border-radius:50%;object-fit:cover;margin-right:8px;" />
            }
            else
            {
                <span style="font-size:22px;margin-right:8px;">@(string.IsNullOrEmpty(avatarPreset) ? "👤" : avatarPreset)</span>
            }
            <span class="fw-bold">@nickname</span>
        </a>
        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3 mt-2" aria-labelledby="userMenuLink">
            <li>
                <a class="dropdown-item py-2" asp-area="Identity" asp-page="/Account/Manage/Index">Профиль</a>
            </li>
            <li><hr class="dropdown-divider"></li>
            <li>
                <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                    <button type="submit" class="dropdown-item py-2 text-danger">Выйти</button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-dark fw-bold" asp-area="Identity" asp-page="/Account/Login">Войти</a>
    </li>
}
</ul>