@using Microsoft.AspNetCore.Identity
@using RecipeSite.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);
    var displayName = currentUser?.FirstName ?? User.Identity?.Name;

    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle d-flex align-items-center text-dark" href="#" id="userMenuLink" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            @if (!string.IsNullOrEmpty(currentUser?.AvatarUrl))
            {
                <img src="@currentUser.AvatarUrl" alt="Аватар" style="width:32px;height:32px;border-radius:50%;object-fit:cover;margin-right:8px;" />
            }
            else if (!string.IsNullOrEmpty(currentUser?.AvatarPreset))
            {
                <span style="font-size:24px;margin-right:8px;">@currentUser.AvatarPreset</span>
            }
            else
            {
                <span style="font-size:24px;margin-right:8px;">🙂</span>
            }
            @displayName
        </a>
        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenuLink">
            <li>
                <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">Профиль</a>
            </li>
            <li><hr class="dropdown-divider"></li>
            <li>
                <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                    <button type="submit" class="dropdown-item">Выйти</button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Register">Регистрация</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">Войти</a>
    </li>
}
</ul>