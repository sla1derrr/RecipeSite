@model RecipeSite.Models.ApplicationUser
@{
    ViewData["Title"] = "Профиль";
}

<div class="container py-4" style="max-width:600px;">
    <h2 class="mb-4">Профиль</h2>

    @if (TempData["Saved"] != null)
    {
        <div class="alert alert-success">@TempData["Saved"]</div>
    }

    <form method="post" enctype="multipart/form-data">
        <div class="mb-3">
            <label class="form-label">Почта</label>
            <input class="form-control" value="@Model.Email" disabled />
        </div>
        <div class="mb-3">
            <label class="form-label">Имя</label>
            <input class="form-control" name="firstName" value="@Model.FirstName" />
        </div>
        <div class="mb-3">
            <label class="form-label">Эмодзи вместо аватарки</label>
            <input class="form-control" name="avatarPreset" value="@Model.AvatarPreset" maxlength="4" />
        </div>
        <div class="mb-3">
            <label class="form-label">Загрузить аватарку (до 2 МБ)</label>
            <input class="form-control" type="file" name="avatar" accept="image/*" />
        </div>
        <button type="submit" class="btn btn-primary">Сохранить</button>
    </form>
</div>