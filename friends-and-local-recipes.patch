@@ -0,0 +1,85 @@
+[
+  {"id":"local_1","title":"Омлет классический","subCategory":"Завтраки","timeEstimate":"10 мин","ingredients":"Яйца 3 шт, молоко 50 мл, соль, сливочное масло.","steps":"Взбить яйца с молоком и солью. Вылить на разогретую сковороду со сливочным маслом. Готовить под крышкой на слабом огне 5-7 минут.","imageUrl":null},
+  {"id":"local_2","title":"Глазунья с беконом","subCategory":"Завтраки","timeEstimate":"7 мин","ingredients":"Яйца 2 шт, бекон 3 полоски, соль, перец.","steps":"Обжарить бекон на сухой сковороде до хруста. Разбить яйца поверх бекона, посолить. Жарить до готовности белка.","imageUrl":null},
+  {"id":"local_3","title":"Овсянка на молоке","subCategory":"Завтраки","timeEstimate":"10 мин","ingredients":"Овсяные хлопья 0.5 стакана, молоко 1 стакан, сахар 1 ч.л., сливочное масло.","steps":"В кипящее молоко всыпать овсянку и сахар. Варить помешивая 5-7 минут. Добавить масло.","imageUrl":null},
+  {"id":"local_4","title":"Сырники из творога","subCategory":"Завтраки","timeEstimate":"20 мин","ingredients":"Творог 400г, яйцо 1 шт, мука 3 ст.л., сахар 2 ст.л., ванилин.","steps":"Смешать творог, яйцо, сахар и муку. Сформировать шайбочки, обвалять в муке. Жарить с двух сторон до румяной корочки.","imageUrl":null},
+  {"id":"local_5","title":"Блины классические","subCategory":"Завтраки","timeEstimate":"30 мин","ingredients":"Молоко 500 мл, яйца 2 шт, мука 200г, сахар 2 ст.л., масло раст. 2 ст.л.","steps":"Взбить яйца с сахаром, добавить часть молока, муку. Перемешать до исчезновения комочков, влить остальное молоко и масло. Выпекать на сковороде.","imageUrl":null},
+  {"id":"local_6","title":"Тост с авокадо","subCategory":"Завтраки","timeEstimate":"5 мин","ingredients":"Хлеб 2 ломтика, авокадо 1 шт, лимонный сок, соль, оливковое масло.","steps":"Хлеб подсушить в тостере. Авокадо размять вилкой, добавить сок лимона и соль. Намазать на хлеб.","imageUrl":null},
+  {"id":"local_7","title":"Ленивые вареники","subCategory":"Завтраки","timeEstimate":"15 мин","ingredients":"Творог 200г, яйцо 1 шт, мука 3-4 ст.л., сахар 1 ст.л.","steps":"Замесить тесто из всех ингредиентов. Скатать колбаску, нарезать на кусочки. Варить в кипящей подсоленной воде 3 минуты после всплытия.","imageUrl":null},
+  {"id":"local_8","title":"Шакшука","subCategory":"Завтраки","timeEstimate":"15 мин","ingredients":"Яйца 3 шт, помидоры 2 шт, лук 0.5 шт, болгарский перец 0.5 шт, чеснок, зира.","steps":"Обжарить лук, перец и чеснок. Добавить нарезанные помидоры, тушить 5 минут. Сделать углубления, разбить в них яйца. Готовить до схватывания белка.","imageUrl":"https://commons.wikimedia.org/wiki/Special:FilePath/Shakshuka_011.jpg"},
+  {"id":"local_9","title":"Рисовая каша","subCategory":"Завтраки","timeEstimate":"25 мин","ingredients":"Рис круглый 0.5 стакана, молоко 1.5 стакана, вода 0.5 стакана, сахар, масло.","steps":"Промыть рис, залить водой и варить до впитывания. Влить горячее молоко, добавить сахар, варить 15 мин на слабом огне.","imageUrl":null},
+  {"id":"local_10","title":"Гренки сладкие","subCategory":"Завтраки","timeEstimate":"10 мин","ingredients":"Батон 4 ломтика, яйцо 1 шт, молоко 50 мл, сахар 1 ч.л.","steps":"Взбить яйцо с молоком и сахаром. Обмакнуть ломтики батона с двух сторон, обжарить на сливочном масле до корочки.","imageUrl":null},
+  {"id":"local_11","title":"Панкейки","subCategory":"Завтраки","timeEstimate":"20 мин","ingredients":"Молоко 1 стакан, мука 1 стакан, яйцо 1 шт, сахар 2 ст.л., разрыхлитель 1 ч.л.","steps":"Смешать сухие и жидкие ингредиенты отдельно, затем соединить. Жарить на сухой антипригарной сковороде с двух сторон.","imageUrl":null},
+  {"id":"local_12","title":"Творожная запеканка","subCategory":"Завтраки","timeEstimate":"45 мин","ingredients":"Творог 500г, яйца 3 шт, манка 3 ст.л., сахар 3 ст.л., сметана 2 ст.л.","steps":"Смешать все ингредиенты миксером. Выложить в смазанную форму, запекать при 180°C около 35-40 минут.","imageUrl":null},
+  {"id":"local_13","title":"Яйцо пашот на тосте","subCategory":"Завтраки","timeEstimate":"10 мин","ingredients":"Яйцо 1 шт, хлеб 1 ломтик, уксус 1 ст.л., сливочный сыр.","steps":"В кипящую воду добавить уксус, сделать воронку, аккуратно влить яйцо. Варить 3 минуты. Выложить на тост с сыром.","imageUrl":null},
+  {"id":"local_14","title":"Горячие бутерброды","subCategory":"Завтраки","timeEstimate":"10 мин","ingredients":"Хлеб 2 ломтика, сыр 50г, колбаса 50г, помидор.","steps":"На хлеб положить колбасу, кружок помидора, сверху посыпать тертым сыром. Запечь в микроволновке или духовке до расплавления сыра.","imageUrl":null},
+  {"id":"local_15","title":"Мюсли с йогуртом","subCategory":"Завтраки","timeEstimate":"3 мин","ingredients":"Мюсли 4 ст.л., натуральный йогурт 150 мл, ягоды или банан.","steps":"Насыпать мюсли в миску, залить йогуртом, сверху украсить нарезанными фруктами или ягодами. Дать постоять 2 минуты.","imageUrl":null},
+  {"id":"local_16","title":"Фриттата с овощами","subCategory":"Завтраки","timeEstimate":"20 мин","ingredients":"Яйца 4 шт, замороженные овощи 150г, сыр 30г, молоко 30 мл.","steps":"Овощи слегка обжарить на сковороде (которую можно ставить в духовку). Залить взбитыми яйцами с молоком. Посыпать сыром, запечь при 180°C 10 минут.","imageUrl":null},
+  {"id":"local_17","title":"Пшенная каша с тыквой","subCategory":"Завтраки","timeEstimate":"30 мин","ingredients":"Пшено 0.5 стакана, тыква 150г, молоко 1 стакан, вода 1 стакан, сахар.","steps":"Пшено ошпарить кипятком. Тыкву нарезать кубиками. Варить всё вместе в воде и молоке до мягкости тыквы и готовности крупы.","imageUrl":null},
+  {"id":"local_18","title":"Бельгийские вафли","subCategory":"Завтраки","timeEstimate":"25 мин","ingredients":"Мука 200г, молоко 200 мл, яйца 2 шт, масло сливочное 100г, сахар 3 ст.л., разрыхлитель.","steps":"Масло растопить. Смешать все ингредиенты до однородности. Выпекать в вафельнице до золотистого цвета.","imageUrl":null},
+  {"id":"local_19","title":"Яблочные оладьи","subCategory":"Завтраки","timeEstimate":"20 мин","ingredients":"Кефир 1 стакан, мука 1 стакан, яйцо 1 шт, яблоко 1 шт, сахар 2 ст.л., сода 0.5 ч.л.","steps":"Вмешать яйцо, кефир, сахар, соду и муку. Яблоко натереть на терке и добавить в тесто. Жарить как обычные оладьи.","imageUrl":null},
+  {"id":"local_20","title":"Ролл с омлетом","subCategory":"Завтраки","timeEstimate":"10 мин","ingredients":"Лаваш 1 лист, яйца 2 шт, сыр 30г, зелень.","steps":"Приготовить тонкий омлет. Положить его на лаваш, посыпать сыром и зеленью, свернуть в рулет. Слегка прогреть на сковороде.","imageUrl":null},
+
+  {"id":"local_21","title":"Борщ классический","subCategory":"Обеды","timeEstimate":"1.5 часа","ingredients":"Говядина на кости 500г, свекла 1 шт, капуста 200г, картофель 3 шт, морковь, лук, томатная паста.","steps":"Сварить бульон. Сделать зажарку из лука, моркови, свеклы и томатной пасты. В бульон добавить картофель, через 10 мин - капусту и зажарку. Варить до готовности.","imageUrl":"https://commons.wikimedia.org/wiki/Special:FilePath/Borscht_with_bread.jpg"},
+  {"id":"local_22","title":"Куриный суп-лапша","subCategory":"Обеды","timeEstimate":"45 мин","ingredients":"Куриное филе 300г, лапша 50г, картофель 2 шт, морковь, лук.","steps":"Сварить куриный бульон. Добавить нарезанный картофель, пассерованные лук и морковь. За 5 минут до готовности добавить лапшу и зелень.","imageUrl":null},
+  {"id":"local_23","title":"Солянка мясная","subCategory":"Обеды","timeEstimate":"1 час","ingredients":"Говядина 300г, колбаса/сосиски 200г, соленые огурцы 3 шт, маслины, томатная паста, лимон.","steps":"Сварить бульон. Обжарить лук, огурцы и томатную пасту. В бульон добавить нарезанные мясные деликатесы, зажарку. Варить 15 мин. Подавать с маслинами и лимоном.","imageUrl":null},
+  {"id":"local_24","title":"Гороховый суп с копченостями","subCategory":"Обеды","timeEstimate":"1.5 часа","ingredients":"Горох колотый 1 стакан, ребра копченые 300г, картофель 2 шт, морковь, лук.","steps":"Горох замочить заранее, сварить с ребрами до мягкости. Добавить картофель, обжаренный лук с морковью. Варить еще 15 минут.","imageUrl":null},
+  {"id":"local_25","title":"Крем-суп грибной","subCategory":"Обеды","timeEstimate":"30 мин","ingredients":"Шампиньоны 400г, картофель 2 шт, лук 1 шт, сливки 10-20% 150 мл.","steps":"Картофель отварить. Грибы и лук обжарить. Соединить всё в блендере, добавить немного бульона от картофеля и сливки, пюрировать. Прогреть.","imageUrl":null},
+  {"id":"local_26","title":"Макароны по-флотски","subCategory":"Обеды","timeEstimate":"25 мин","ingredients":"Макароны 200г, фарш мясной 300г, лук 1 шт, масло, соль, перец.","steps":"Макароны отварить. Фарш обжарить с мелко нарезанным луком до готовности. Смешать фарш с макаронами, прогреть вместе 2 минуты.","imageUrl":null},
+  {"id":"local_27","title":"Плов с курицей","subCategory":"Обеды","timeEstimate":"1 час","ingredients":"Рис длиннозерный 1.5 стакана, курица 400г, морковь 2 шт, лук 2 шт, чеснок, специи для плова.","steps":"В казане обжарить мясо, добавить лук и морковь соломкой, потушить (зирвак). Засыпать промытый рис, залить водой на 2 см выше риса. Варить до выпаривания, воткнуть чеснок.","imageUrl":"https://commons.wikimedia.org/wiki/Special:FilePath/Plov.jpg"},
+  {"id":"local_28","title":"Картофельное пюре с котлетой","subCategory":"Обеды","timeEstimate":"45 мин","ingredients":"Картофель 500г, молоко, масло. Для котлет: фарш 400г, лук, хлеб, яйцо.","steps":"Картошку сварить, размять с молоком и маслом. Из фарша, замоченного хлеба, лука и яйца слепить котлеты. Обжарить с двух сторон.","imageUrl":null},
+  {"id":"local_29","title":"Гречка с гуляшом","subCategory":"Обеды","timeEstimate":"1 час","ingredients":"Гречка 1 стакан, говядина/свинина 400г, лук, морковь, томатная паста, мука 1 ст.л.","steps":"Гречку отварить. Мясо нарезать кусочками, обжарить с луком и морковью, добавить муку и томатную пасту, залить водой и тушить 40 минут.","imageUrl":null},
+  {"id":"local_30","title":"Паста Карбонара","subCategory":"Обеды","timeEstimate":"20 мин","ingredients":"Спагетти 200г, бекон 100г, желтки 2 шт, сыр пармезан 50г, сливки 50 мл.","steps":"Отварить спагетти. Обжарить бекон. Смешать желтки, сливки и тертый сыр. Горячую пасту кинуть к бекону, влить соус, быстро перемешать и снять с огня.","imageUrl":"https://commons.wikimedia.org/wiki/Special:FilePath/Spaghetti_carbonara.jpg"},
+  {"id":"local_31","title":"Пельмени в бульоне","subCategory":"Обеды","timeEstimate":"15 мин","ingredients":"Пельмени 250г, бульон или вода, лавровый лист, зелень, сметана.","steps":"Вскипятить воду или бульон с солью и лавровым листом. Закинуть пельмени, варить 5-7 минут после всплытия. Подавать с бульоном и сметаной.","imageUrl":null},
+  {"id":"local_32","title":"Рассольник","subCategory":"Обеды","timeEstimate":"1 час","ingredients":"Мясо для бульона 300г, перловка 3 ст.л., картофель 2 шт, соленые огурцы 2 шт, морковь, лук.","steps":"Сварить бульон с перловкой. Добавить картофель. Сделать зажарку из лука, моркови и тертых огурцов. Добавить в суп, варить 10 минут.","imageUrl":null},
+  {"id":"local_33","title":"Уха из красной рыбы","subCategory":"Обеды","timeEstimate":"40 мин","ingredients":"Суповой набор лосося/форели 400г, картофель 3 шт, морковь, лук, перец горошком.","steps":"Сварить бульон из рыбы (20 мин), процедить. Разобрать рыбу от костей. В бульон кинуть картофель, морковь, целую луковицу. Варить 15 мин, вернуть рыбу.","imageUrl":null},
+  {"id":"local_34","title":"Лагман","subCategory":"Обеды","timeEstimate":"1.5 часа","ingredients":"Говядина 300г, лапша для лагмана, редька 1 шт, перец болгарский 1 шт, картофель 2 шт, томатная паста.","steps":"Мясо и овощи нарезать кубиком. Обжарить мясо, добавить овощи и томатную пасту, залить водой, тушить до готовности (ваджа). Подавать на отварной лапше.","imageUrl":null},
+  {"id":"local_35","title":"Суп-пюре из тыквы","subCategory":"Обеды","timeEstimate":"40 мин","ingredients":"Тыква 400г, картофель 1 шт, лук 1 шт, сливки 100 мл, тыквенные семечки.","steps":"Овощи крупно нарезать, отварить в небольшом количестве воды до мягкости. Пюрировать блендером, влить сливки, прогреть. Посыпать семечками.","imageUrl":null},
+  {"id":"local_36","title":"Щи из свежей капусты","subCategory":"Обеды","timeEstimate":"1 час","ingredients":"Курица 300г, капуста 250г, картофель 2 шт, помидор 1 шт, морковь, лук.","steps":"В куриный бульон добавить нашинкованную капусту и картофель. Сделать зажарку из лука, моркови и помидора, добавить в суп. Варить до мягкости капусты.","imageUrl":null},
+  {"id":"local_37","title":"Спагетти Болоньезе","subCategory":"Обеды","timeEstimate":"40 мин","ingredients":"Спагетти 200г, фарш 300г, лук 1 шт, морковь 1 шт, томатный соус 200г, чеснок.","steps":"Обжарить лук и морковь, добавить фарш, жарить до готовности. Влить томатный соус и тушить 15 мин. Подавать соус поверх отварных спагетти.","imageUrl":null},
+  {"id":"local_38","title":"Рис с курицей карри","subCategory":"Обеды","timeEstimate":"30 мин","ingredients":"Рис 1 стакан, куриное филе 300г, сливки 100 мл, карри 1 ч.л., лук.","steps":"Рис отварить. Филе нарезать, обжарить с луком. Посыпать приправой карри, залить сливками и тушить 5-7 минут. Подавать с рисом.","imageUrl":null},
+  {"id":"local_39","title":"Окрошка на квасе/кефире","subCategory":"Обеды","timeEstimate":"20 мин","ingredients":"Колбаса вареная 200г, картофель отварной 2 шт, яйца вареные 3 шт, огурец 2 шт, редис, зелень, квас или кефир.","steps":"Все ингредиенты нарезать мелким кубиком, зелень порубить. Смешать, посолить, залить холодным квасом или кефиром с минералкой.","imageUrl":null},
+  {"id":"local_40","title":"Сырный суп с курицей","subCategory":"Обеды","timeEstimate":"35 мин","ingredients":"Куриное филе 200г, плавленый сырок 2 шт (по 90г), картофель 2 шт, морковь, лук.","steps":"Сварить филе, нарезать. В бульон кинуть картофель. Сделать зажарку. Когда картошка готова, добавить зажарку, мясо и натертые сырки. Мешать до растворения сыра.","imageUrl":null},
+
+  {"id":"local_41","title":"Куриные ножки в аэрогриле","subCategory":"Ужины","timeEstimate":"30 мин","ingredients":"Куриные голени 6 шт, паприка, чеснок сушеный, соль, ложка масла.","steps":"Голени натереть специями, солью и каплей масла. Выложить в чашу аэрогриля, запекать при 190°C около 20-25 минут до хрустящей корочки.","imageUrl":null},
+  {"id":"local_42","title":"Отбивные из свинины","subCategory":"Ужины","timeEstimate":"20 мин","ingredients":"Корейка свиная 400г, яйцо 1 шт, панировочные сухари, соль, перец.","steps":"Мясо нарезать на порции, отбить молотком. Посолить, поперчить. Обмакнуть во взбитое яйцо, затем в сухари. Жарить с двух сторон по 5-7 минут.","imageUrl":null},
