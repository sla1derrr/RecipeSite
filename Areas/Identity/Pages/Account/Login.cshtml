@page
@model LoginModel

@{
    ViewData["Title"] = "Вход";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm border-0 rounded-4 p-4 bg-white">
            <form id="account" method="post">
                <h2 class="text-center fw-bold mb-4" style="color: #ff6b8b;">Вход в Foodify</h2>
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label text-muted small fw-bold">Email</label>
                    <input asp-for="Input.Email" class="form-control rounded-3 py-2" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label text-muted small fw-bold">Пароль</label>
                    <input asp-for="Input.Password" class="form-control rounded-3 py-2" autocomplete="current-password" aria-required="true" placeholder="••••••••" />
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <div class="checkbox mb-4">
                    <label asp-for="Input.RememberMe" class="form-label text-muted">
                        <input class="form-check-input" asp-for="Input.RememberMe" />
                        @Html.DisplayNameFor(m => m.Input.RememberMe)
                    </label>
                </div>

                <button id="login-submit" type="submit" class="w-100 btn btn-lg text-white shadow-sm rounded-3 mb-3" style="background-color: #ff6b8b; border: none;">Войти</button>

                <div class="text-center mt-3 border-top pt-3">
                    <p class="text-muted small mb-2">Нет аккаунта?</p>
                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="btn btn-outline-secondary w-100 rounded-3 mb-3">Зарегистрироваться</a>
                    <p class="mb-0">
                        <a id="forgot-password" asp-page="./ForgotPassword" class="text-decoration-none text-muted small">Забыли пароль?</a>
                    </p>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}