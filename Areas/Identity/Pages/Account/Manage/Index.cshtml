@page
@model IndexModel
@{
    ViewData["Title"] = "Профиль";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<h4 class="fw-bold mb-4">Профиль</h4>
<partial name="_StatusMessage" for="StatusMessage" />

<form id="profile-form" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>

    <div class="row align-items-center mb-4">
        <div class="col-12">
            <div class="d-flex align-items-center p-3 rounded-3 bg-light border">
                <div class="me-3">
                    @if (!string.IsNullOrEmpty(Model.CurrentAvatar) && (Model.CurrentAvatar.StartsWith("/") ||
                                    Model.CurrentAvatar.StartsWith("http")))
                    {
                        <img src="@Model.CurrentAvatar" alt="Avatar" class="rounded-circle shadow-sm"
                             style="width: 65px; height: 65px; object-fit: cover;" id="avatar-preview" />
                    }
                    else if (!string.IsNullOrEmpty(Model.CurrentAvatar))
                    {
                        <div class="fs-1 d-flex align-items-center justify-content-center bg-white rounded-circle shadow-sm"
                             style="width: 65px; height: 65px;" id="avatar-preview">
                            @Model.CurrentAvatar
                        </div>
                    }
                    else
                    {
                        <div class="fs-1 d-flex align-items-center justify-content-center bg-white rounded-circle shadow-sm text-muted"
                             style="width: 65px; height: 65px;" id="avatar-preview">
                            👤
                        </div>
                    }
                </div>
                <div>
                    <span class="text-muted small d-block">Текущий аккаунт</span>
                    <h4 class="fw-bold mb-0 text-dark">@Model.Input.NewUsername</h4>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Левая колонка: Никнейм -->
        <div class="col-lg-6">
            <div class="mb-3">
                <label asp-for="Input.NewUsername" class="form-label text-muted small fw-bold">Никнейм</label>
                <input asp-for="Input.NewUsername" class="form-control rounded-3 py-2"
                       placeholder="Введите ваш никнейм" />
                <span asp-validation-for="Input.NewUsername" class="text-danger small"></span>
            </div>
        </div>

        <!-- Правая колонка: Выбор смайлика или файла -->
        <div class="col-lg-6 border-start ps-lg-4 mt-4 mt-lg-0">
            <div class="mb-3">
                <label class="form-label text-muted small fw-bold">Выберите стандартный смайлик</label>
                <div class="d-flex flex-wrap gap-2 mt-1">
                    @foreach (var emoji in new[] { "🍳", "🍕", "🍰", "🍜", "🍇", "🥑", "😎", "🐱", "🚀" })
                    {
                        <div class="form-check p-0">
                            <input type="radio" class="btn-check" name="SelectedEmoji" id="emoji-@emoji" value="@emoji" autocomplete="off">
                            <label class="btn btn-outline-danger rounded-circle p-0 fs-5 d-flex align-items-center justify-content-center shadow-sm"
                                   style="width: 45px; height: 45px; cursor: pointer;" for="emoji-@emoji">
                                @emoji
                            </label>
                        </div>
                    }
                </div>
            </div>

            <div class="mb-3 mt-4">
                <label class="form-label text-muted small fw-bold">Или загрузите свою картинку</label>
                <!-- Имя поля изменено на AvatarFile (без Input.) -->
                <input type="file" id="avatarFileinput" name="AvatarFile" class="form-control rounded-3 py-2" accept="image/*" />
            </div>
        </div>
    </div>

    <button type="submit" class="w-100 btn btn-lg mt-4 shadow-sm text-white rounded-3"
            style="background-color: #ff6b8b; border: none; cursor: pointer; position: relative; z-index: 10;">
        Сохранить профиль
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('avatarFileinput').addEventListener('change', function (event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    const preview = document.getElementById('avatar-preview');
                    if (preview && preview.tagName === 'IMG') {
                        preview.src = e.target.result;
                    } else if (preview) {
                        const newImg = document.createElement('img');
                        newImg.src = e.target.result;
                        newImg.className = 'rounded-circle shadow-sm';
                        newImg.style.width = '65px';
                        newImg.style.height = '65px';
                        newImg.style.objectFit = 'cover';
                        newImg.id = 'avatar-preview';
                        preview.parentNode.replaceChild(newImg, preview);
                    }
                }
                reader.readAsDataURL(file);
            }
        });
    </script>
}