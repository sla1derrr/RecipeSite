@page
@model IndexModel
@{
    ViewData["Title"] = "Profile";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<h3>@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />
<div class="row">
    <div class="col-md-6">

        <!-- Блок аватарки -->
        <div class="mb-4 text-center">
            @if (!string.IsNullOrEmpty(Model.CurrentAvatarUrl))
            {
                <img src="@Model.CurrentAvatarUrl" alt="Аватар"
                     style="width:100px;height:100px;border-radius:50%;object-fit:cover;" />
            }
            else if (!string.IsNullOrEmpty(Model.CurrentAvatarPreset))
            {
                <div style="font-size:60px;">@Model.CurrentAvatarPreset</div>
            }
            else
            {
                <div
                    style="width:100px;height:100px;border-radius:50%;background:#eee;margin:0 auto;display:flex;align-items:center;justify-content:center;font-size:40px;">
                    🙂</div>
                }
            </div>

            <form id="profile-form" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Username" class="form-control" placeholder="Please choose your username." disabled />
                    <label asp-for="Username" class="form-label"></label>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.FirstName" class="form-control" placeholder="Имя" />
                    <label asp-for="Input.FirstName" class="form-label"></label>
                    <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.LastName" class="form-control" placeholder="Фамилия" />
                    <label asp-for="Input.LastName" class="form-label"></label>
                    <span asp-validation-for="Input.LastName" class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.PhoneNumber" class="form-control" placeholder="Please enter your phone number." />
                    <label asp-for="Input.PhoneNumber" class="form-label"></label>
                    <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                </div>

                <!-- Выбор готовой иконки -->
                <!-- Выбор готовой иконки -->
                <div class="mb-3">
                    <label class="form-label d-block">Выбери готовую иконку</label>
                    <div id="avatar-preset-list">
                        @foreach (var preset in IndexModel.AvatarPresets)
                        {
                            <label class="avatar-preset-label"
                                   style="display:inline-block; margin-right:8px; padding:6px; border-radius:8px; cursor:pointer; outline:@(Model.Input.AvatarPreset == preset ? "2px solid #0d6efd" : "none");">
                                <input type="radio" name="Input.AvatarPreset" value="@preset"
                                       checked="@(Model.Input.AvatarPreset == preset)" style="display:none;"
                                       onchange="selectAvatarPreset(this)" />
                                <span style="font-size:32px;">@preset</span>
                            </label>
                        }
                    </div>
                </div>

                <script>
                                function selectAvatarPreset(selectedInput) {
                                    // Убираем подсветку у всех иконок
                                    document.querySelectorAll('.avatar-preset-label').forEach(function (label) {
                                        label.style.outline = 'none';
                                    });
                                    // Подсвечиваем только выбранную
                                    selectedInput.parentElement.style.outline = '2px solid #0d6efd';
                                }
                </script>

                <!-- Загрузка своей картинки -->
                <div class="mb-3">
                    <label asp-for="Input.AvatarFile" class="form-label">Или загрузи свою картинку</label>
                    <input asp-for="Input.AvatarFile" type="file" class="form-control" accept="image/*" />
                </div>

                <button id="update-profile-button" type="submit" class="w-100 btn btn-lg btn-primary">Save</button>
            </form>
        </div>
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }