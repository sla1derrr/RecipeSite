@page
@model IndexModel
@{
    ViewData["Title"] = "Профиль";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<h4 class="fw-bold mb-4">@ViewData["Title"]</h4>
<partial name="_StatusMessage" for="StatusMessage" />

<form id="profile-form" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
    
    <div class="row">
        <!-- Левая часть: Текстовые поля -->
        <div class="col-lg-7">
            <div class="form-floating mb-3">
                <input asp-for="Username" class="form-control" disabled />
                <label asp-for="Username" class="form-label">Email (Логин)</label>
            </div>

            <!-- ВСТАВЬТЕ СЮДА ВАШИ ИСХОДНЫЕ ПОЛЯ: Input.Name, Input.Surname, Input.PhoneNumber -->
            
        </div>

        <!-- Правая часть: Аватарка -->
        <div class="col-lg-5 border-start ps-lg-4 mt-4 mt-lg-0">
            <div class="text-center mb-4">
                <div class="d-inline-block p-3 rounded-circle shadow-sm mb-2" style="background-color: #fff0f4;">
                    <!-- ВСТАВЬТЕ СЮДА ВАШ ТЕГ <img> ДЛЯ ВЫВОДА ТЕКУЩЕГО АВАТАРА -->
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label text-muted small fw-bold">Выберите готовую иконку</label>
                <div class="d-flex flex-wrap gap-2">
                    <!-- ВСТАВЬТЕ СЮДА ВАШИ РАДИО-КНОПКИ С EMOJI -->
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label text-muted small fw-bold">Или загрузите свою картинку</label>
                <!-- ВСТАВЬТЕ СЮДА ВАШ INPUT TYPE="FILE" -->
            </div>
        </div>
    </div>

    <button id="update-profile-button" type="submit" class="w-100 btn btn-lg mt-4 shadow-sm" style="background-color: #ff6b8b; color: white; border: none; border-radius: 12px;">
        Сохранить изменения
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}