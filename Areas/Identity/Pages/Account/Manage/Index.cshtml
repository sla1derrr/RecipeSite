@page
@model IndexModel
@{
    ViewData["Title"] = "Профиль";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<h4 class="fw-bold mb-4">@ViewData["Title"]</h4>
<partial name="_StatusMessage" for="StatusMessage" />

<form id="profile-form" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

    <div class="row">
        <!-- Никнейм -->
        <!-- Никнейм -->
        <div class="col-lg-6">
            <div class="form-floating mb-3">
                <input asp-for="Input.NewUsername" class="form-control" placeholder="Никнейм" />
                <label asp-for="Input.NewUsername" class="form-label">Никнейм</label>
            </div>
        </div>

        <!-- Аватарка -->
        <div class="col-lg-6 border-start ps-lg-4 mt-4 mt-lg-0">
            <div class="mb-4">
                <label class="form-label text-muted small fw-bold">Выберите готовую иконку</label>
                <div class="d-flex flex-wrap gap-2 mt-2">
                    <!-- Сюда вставьте ваши input type="radio" с emoji -->
                </div>
            </div>

            <div class="mb-3 mt-4">
                <label class="form-label text-muted small fw-bold">Или загрузите свою картинку</label>
                <input type="file" name="Input.AvatarFile" class="form-control" accept="image/*" />
            </div>
        </div>
    </div>

    <button id="update-profile-button" type="submit" class="w-100 btn btn-lg mt-4 shadow-sm"
            style="background-color: #ff6b8b; color: white; border: none; border-radius: 12px;">
        Сохранить профиль
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}