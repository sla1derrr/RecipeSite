@page
@model IndexModel
@{
    ViewData["Title"] = "Профиль";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<h4 class="fw-bold mb-4">@ViewData["Title"]</h4>
<partial name="_StatusMessage" for="StatusMessage" />

<form id="profile-form" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

    <div class="row">
        <!-- Никнейм -->
        <div class="col-lg-6">
            <div class="mb-3">
                <label asp-for="Input.NewUsername" class="form-label text-muted small fw-bold">Никнейм</label>
                <input asp-for="Input.NewUsername" class="form-control rounded-3 py-2" placeholder="Введите никнейм" />
                <span asp-validation-for="Input.NewUsername" class="text-danger small"></span>
            </div>
        </div>

        <!-- Аватарка -->
        <div class="col-lg-6 border-start ps-lg-4 mt-4 mt-lg-0">
            <div class="mb-3">
                <label class="form-label text-muted small fw-bold">Или загрузите свою картинку</label>
                <input type="file" name="Input.AvatarFile" class="form-control rounded-3 py-2" accept="image/*" />
            </div>
        </div>
    </div>

    <button id="update-profile-button" type="submit" class="w-100 btn btn-lg mt-4 shadow-sm text-white rounded-3"
            style="background-color: #ff6b8b; border: none;">
        Сохранить профиль
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}