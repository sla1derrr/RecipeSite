@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Удаление аккаунта";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h4 class="fw-bold mb-4 text-danger">@ViewData["Title"]</h4>

<div class="alert alert-warning rounded-3 border-0 shadow-sm mb-4" role="alert" style="background-color: #fff3f3; color: #dc3545;">
    <p class="mb-0">
        <strong>Внимание!</strong> При удалении учетной записи навсегда теряются все ваши данные, сохраненные рецепты и настройки. Это действие невозможно отменить.
    </p>
</div>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
    
    <div class="form-floating mb-3">
        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Пароль" />
        <label asp-for="Input.Password" class="form-label">Введите ваш пароль для подтверждения</label>
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>
    
    <button type="submit" class="w-100 btn btn-danger btn-lg mt-2 rounded-3 shadow-sm">Удалить учетную запись навсегда</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}