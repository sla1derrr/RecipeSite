@page
@model EmailModel
@{
    ViewData["Title"] = "Личные данные";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<h4 class="fw-bold mb-4">Личные данные</h4>
<partial name="_StatusMessage" for="StatusMessage" />

<form id="email-form" method="post">
    <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>

    <div class="mb-3">
        <label class="form-label text-muted small fw-bold">Текущая почта</label>
        <input asp-for="Input.NewEmail" class="form-control rounded-3 py-2" disabled placeholder="Текущий email" />
    </div>

    <div class="mb-3">
        <label asp-for="Input.NewEmail" class="form-label text-muted small fw-bold">Новая почта</label>
        <input asp-for="Input.NewEmail" class="form-control rounded-3 py-2" autocomplete="email" aria-required="true"
               placeholder="Введите новый email" />
        <span asp-validation-for="Input.NewEmail" class="text-danger small"></span>
    </div>

    <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail"
            class="w-100 btn btn-lg mt-4 shadow-sm text-white rounded-3" style="background-color: #ff6b8b; border: none;">
        Изменить почту
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}